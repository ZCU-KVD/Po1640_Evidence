@page "/evidence"

<PageTitle>Evidence financí</PageTitle>

<h2>Evidence nákladů a výnosů</h2>

<div class="card">
    <div class="card-body">
        <EditForm Model="formularTransakce" OnValidSubmit="UlozitTransakci">
            <DataAnnotationsValidator />
            <div class="row align-items-end">
                <div class="col mb-3 mt-3">
                    <label for="datum" class="form-label">Datum:</label>
                    <InputDate class="form-control" id="datum" @bind-Value="formularTransakce.Datum" placeholder="Vložte datum" />
                    <ValidationMessage For="@(() => formularTransakce.Datum)" />
                </div>

                <div class="col mb-3 mt-3">
                    <label for="vynosy" class="form-label">Výnosy:</label>
                    <InputNumber class="form-control" id="vynosy" @bind-Value="formularTransakce.Vynosy" placeholder="Vložte výnosy" />
                    <ValidationMessage For="@(() => formularTransakce.Vynosy)" />
                </div>

                <div class="col mb-3 mt-3">
                    <label for="naklady" class="form-label">Náklady:</label>
                    <InputNumber class="form-control" id="naklady" @bind-Value="formularTransakce.Naklady" placeholder="Vložte náklady" />
                    <ValidationMessage For="@(() => formularTransakce.Naklady)" />
                </div>

                <div class="col mb-3 mt-3">
                    <label for="popis" class="form-label">Popis:</label>
                    <InputText class="form-control" id="popis" @bind-Value="formularTransakce.Popis" placeholder="Vložte popis" />
                    <ValidationMessage For="@(() => formularTransakce.Popis)" />
                </div>

                <div class="col mb-3 mt-3">
                    <button type="submit" class="btn btn-primary">Přidat záznam</button>
                </div>
            </div>
        </EditForm>
    </div>
</div>

<div class="container mt-3">
    <table class="table">
        <thead class="table-dark">
            <tr>
                <th>Datum</th>
                <th>Popis</th>
                <th>Výnosy</th>
                <th>Náklady</th>
                <th>Zisk</th>
                <th>Akce</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var itemTranskace in EvidenceService.TransakceSeznam)
            {
                var tridaZisku = itemTranskace.Zisk >= 0 ? "text-success" : "text-danger";
                <tr>
                    <td>@itemTranskace.Datum.ToShortDateString()</td>
                    <td>@itemTranskace.Popis</td>
                    <td class="text-end text-success">@itemTranskace.Vynosy.ToString("N2")</td>
                    <td class="text-end text-danger">@itemTranskace.Naklady.ToString("N2")</td>
                    <td class="text-end @tridaZisku">@itemTranskace.Zisk.ToString("N2")</td>
                    <td>
                        <button type="button" class="btn btn-outline-primary">
                            <span class="material-symbols-outlined">
                                edit
                            </span>
                            Upravit
                        </button>
                        <button type="button" @onclick="()=>SmazatTransakci(itemTranskace)" class="btn btn-outline-danger">
                            <span class="material-symbols-outlined">
                                delete
                            </span>
                            Smazat
                        </button>
                    </td>
                </tr>
            }
          
        </tbody>
    </table>
  
</div>

